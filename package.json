{
  "name": "vue-boilerplate-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode localhost",
    "dev:dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:stg": "vite build --mode staging",
    "preview": "vite preview --mode production",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,vue,scss,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "js-cookie": "^3.0.5",
    "pinia": "2.1.7",
    "vue": "3.3.4",
    "vue-dompurify-html": "5.2.0",
    "vue-router": "4.5.1",
    "vue-toast-notification": "^3.1.3",
    "vuetify": "3.7.19"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.28.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.89.1",
    "vite": "^6.3.5",
    "vite-plugin-vuetify": "2.1.1"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": [
      "prettier --write"
    ]
  }
}
