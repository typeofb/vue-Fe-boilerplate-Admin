# ------------------------------------------------------------
# 모든 모드 공통 (모드별 파일이 같은 키를 덮어씁니다)
# 개인 PC 전용 값은 .env.local / .env.[mode].local 에 작성 (git 제외)
# ※ VITE_ 접두사가 붙은 값은 번들에 그대로 노출됩니다. 비밀 키를 넣지 마세요.
# ------------------------------------------------------------
VITE_APP_TITLE=Boilerplate Admin
VITE_PORT=8610

# API
VITE_API_TIMEOUT=30000

# 쿠키/스토리지 키 prefix (같은 도메인의 다른 프로젝트와 충돌 방지)
VITE_STORAGE_PREFIX=bp_admin

# 미사용 시 자동 로그아웃 (분, 0 이면 사용 안 함)
VITE_IDLE_TIMEOUT_MIN=60

# Mock API 사용 여부 (src/mocks)
VITE_USE_MOCK=false

# 에러 모니터링 (Sentry 등, 비어 있으면 사용 안 함)
VITE_SENTRY_DSN=
