{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 4,
  "useTabs": false,
  "printWidth": 120,
  "bracketSpacing": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": {"tabWidth": 2}
    }
  ]
}
